# VoiceArmor Configuration
APP_NAME="VoiceArmor AI Security Center"
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL="sqlite:///./voicearmor.db"

# AI Engine Options: "AUTO", "LIGHTWEIGHT", "DEMO"
AI_ENGINE_MODE="AUTO"

# Risk Thresholds
RISK_THRESHOLD_MODERATE=21
RISK_THRESHOLD_HIGH=51
RISK_THRESHOLD_CRITICAL=76

# Privacy Policy
RAW_AUDIO_RETENTION_SECONDS=0
STORE_EMBEDDINGS_ONLY=True

# Multilingual Defaults
DEFAULT_LANGUAGE="auto"
SUPPORTED_LANGUAGES="en,hi,ta,te,bn,mr,gu,kn,pa"
